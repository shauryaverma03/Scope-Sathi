# Safe local demo. Only binds to loopback and never calls Google APIs.
APP_MODE=demo
PORT=8080
# For real Google mode: run npm run cloud:configure, see docs/GOOGLE_SETUP.md.
# APP_MODE=google
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=choose-a-current-Vertex-AI-model
# FIREBASE_WEB_CONFIG={"apiKey":"public-web-config","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"web-app-id"}

# Free Firebase + local backend (no billing)
# APP_MODE=firebase
# STORAGE_BACKEND=local
# Use firestore after setting Admin credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/admin-key.json
# GEMINI_API_KEY=optional-private-AI-Studio-key
# GEMINI_MODEL=available-free-tier-model

# Optional transactional emails. Private SMTP password stays on the backend.
# EMAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=private-app-password
# EMAIL_FROM="ScopeSathi <your-sender@gmail.com>"
# APP_PUBLIC_URL=https://your-public-app.example
# ScopeSathi's current deployed origin (google mode defaults to this for scopesathi):
# APP_PUBLIC_URL=https://scopesathi-api-112358672382.europe-west1.run.app
# Hosted mail requires an OIDC-authenticated Scheduler; see docs/CLOUD_RUN_RELEASE.md.
# MAIL_TRIGGER_SERVICE_ACCOUNT=scopesathi-mail-scheduler@scopesathi.iam.gserviceaccount.com

# Explicit local email testing; false by default. Never use for public deployment.
# EMAIL_LOCAL_TEST=false
